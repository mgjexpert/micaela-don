# ============================================================================
# Example environment — copy to .env (local dev) or set in Vercel (production).
# NEVER commit the real .env (it is gitignored).
# ============================================================================

# --- Database ---
# LOCAL DEV (SQLite sandbox): DATABASE_URL points to a local file.
#   Run: bun run db:push:dev   (uses prisma/schema.dev.prisma)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# PRODUCTION (Supabase PostgreSQL via PgBouncer, port 6543):
#   DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# (DIRECT_DATABASE_URL is the non-pooled connection, used by migrations/seed.)
#
# IMPORTANT: in production, DATABASE_URL must include ?pgbouncer=true&connection_limit=1
# because Supabase's pooled endpoint uses transaction mode (Prisma needs these params).

# --- Supabase (publishable/anon key — safe for frontend) ---
# The SERVICE_ROLE key is server-only: set SUPABASE_SERVICE_ROLE_KEY in Vercel (never NEXT_PUBLIC).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# --- Admin authentication (server-only) ---
# Generate with:
#   bun run scripts/gen-session-secret.ts      → SESSION_SECRET
#   bun run scripts/hash-password.ts "<pass>"  → ADMIN_PASSWORD_HASH
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt:<saltHex>:<hashHex>
SESSION_SECRET=<long-random-string>

# --- Private storage for uploaded PIX QR (server-only path) ---
PRIVATE_ASSETS_DIR=/home/z/my-project/private-assets

# --- Initial config (read once by the seed script, only if the rows don't exist yet) ---
# All values are seeded as DRAFT / DISABLED. The admin must verify and publish.
INIT_PAYMENT_CURRENCY=EUR
INIT_PAYMENT_HOLDER=
INIT_PAYMENT_BANK=
INIT_PAYMENT_IBAN=
INIT_PAYMENT_BIC=
INIT_PAYMENT_METHOD=Transferência bancária SEPA
INIT_WHATSAPP_LABEL=
INIT_WHATSAPP_VALUE=

# Canonical public application URL for server-side payment callbacks (not user-controlled Origin)
APP_BASE_URL=https://ajudar.charity

# --- Stripe (MB WAY, Portugal) — server-only ---
# STRIPE_SECRET_KEY=sk_test_... (test) or sk_live_... (production)
# STRIPE_WEBHOOK_SECRET=whsec_... (from Stripe Dashboard webhook endpoint)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PixGo (PIX automático, Brasil) — server-only ---
# PIXGO_API_KEY= (from PixGo dashboard)
# PIXGO_WEBHOOK_SECRET= (PixGo webhook signing secret)
PIXGO_API_KEY=
PIXGO_WEBHOOK_SECRET=

# --- MisticPay (PIX automático, Brasil) — server-only ---
# Docs: https://docs.misticpay.com/
# MISTICPAY_CLIENT_ID=ci_... (Client ID)
# MISTICPAY_CLIENT_SECRET=cs_... (Client Secret)
# MISTICPAY_WEBHOOK_SECRET= (optional shared secret for webhook validation)
MISTICPAY_CLIENT_ID=
MISTICPAY_CLIENT_SECRET=
MISTICPAY_WEBHOOK_SECRET=

# --- Telegram (alerts for manual PIX) — server-only ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Resend (email) — server-only ---
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
